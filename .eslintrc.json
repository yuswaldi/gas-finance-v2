{
  "env": {
    "es2021": true
  },
  "extends": "eslint:recommended",
  "parserOptions": {
    "ecmaVersion": 12,
    "sourceType": "script"
  },
  "globals": {
    "SpreadsheetApp": "readonly",
    "DriveApp": "readonly",
    "UrlFetchApp": "readonly",
    "Utilities": "readonly",
    "Logger": "readonly",
    "Session": "readonly",
    "LockService": "readonly",
    "PropertiesService": "readonly",
    "HtmlService": "readonly",
    "CacheService": "readonly",
    "ScriptApp": "readonly",
    "AuthConfig": "writable",
    "OAuthChallenge": "writable",
    "OAuthToken": "writable",
    "AuthAllowlist": "writable",
    "AuthSession": "writable",
    "AuthAuthorization": "writable",
    "SchemaRegistry": "writable",
    "SchemaMigrations": "writable"
  },
  "rules": {
    "no-unused-vars": [
      "warn",
      {
        "vars": "local",
        "args": "after-used",
        "argsIgnorePattern": "^_"
      }
    ],
    "no-undef": "error",
    "no-redeclare": [
      "error",
      {
        "builtinGlobals": false
      }
    ]
  },
  "overrides": [
    {
      "files": ["tests/**/*.js", "scripts/**/*.js"],
      "env": {
        "node": true
      }
    }
  ]
}
